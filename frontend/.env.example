# Server-only backend origin. Never prefix this value with NEXT_PUBLIC_.
OPENSCHOLAR_API_BASE_URL=http://localhost:8080

# Authentication defaults to local mode and ignores the OIDC settings below.
# Hosted deployments set this to oidc and provide every required value over
# HTTPS. These values are server-only: never prefix them with NEXT_PUBLIC_.
OPENSCHOLAR_AUTH_MODE=local
# OPENSCHOLAR_AUTH_SESSION_SECRET=<base64 value from: openssl rand -base64 32>
# OPENSCHOLAR_AUTH_SESSION_MAX_AGE_SECONDS=28800
# OPENSCHOLAR_OIDC_ISSUER=https://identity.example.com
# OPENSCHOLAR_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/oauth2/authorize
# OPENSCHOLAR_OIDC_TOKEN_ENDPOINT=https://identity.example.com/oauth2/token
# OPENSCHOLAR_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# OPENSCHOLAR_OIDC_END_SESSION_ENDPOINT=https://identity.example.com/logout
# OPENSCHOLAR_OIDC_CLIENT_ID=openscholar-web
# OPENSCHOLAR_OIDC_CLIENT_AUTH_METHOD=none
# OPENSCHOLAR_OIDC_CLIENT_SECRET=
# OPENSCHOLAR_OIDC_REDIRECT_URI=https://research.example.com/api/auth/callback
# OPENSCHOLAR_OIDC_POST_LOGOUT_REDIRECT_URI=https://research.example.com/
# OPENSCHOLAR_OIDC_SCOPES=openid profile openscholar.search openscholar.library openscholar.privacy
# OPENSCHOLAR_OIDC_ID_TOKEN_ALGS=RS256
NEXT_TELEMETRY_DISABLED=1
