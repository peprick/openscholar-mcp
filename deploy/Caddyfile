{
	admin off
	email {$ACME_EMAIL}
	servers {
		0rtt off
		strict_sni_host on
		max_header_size 32KB
		timeouts {
			read_body 30s
			read_header 10s
			write 45s
			idle 2m
		}
	}
}

{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'none'; child-src 'self'; connect-src 'self' https:; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; img-src 'self' data: blob:; manifest-src 'self'; media-src 'none'; object-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=()"
	}

	request_body {
		max_size 2MB
	}

	@backend_rest path /api/v1/*
	handle @backend_rest {
		reverse_proxy backend:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy backend:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	@oauth_metadata path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @oauth_metadata {
		reverse_proxy backend:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle {
		reverse_proxy frontend:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace access_token REDACTED
					replace code REDACTED
					replace code_challenge REDACTED
					replace error REDACTED
					replace error_description REDACTED
					replace error_uri REDACTED
					replace id_token REDACTED
					replace identifier REDACTED
					replace nonce REDACTED
					replace q REDACTED
					replace query REDACTED
					replace cursor REDACTED
					replace refresh_token REDACTED
					replace returnTo REDACTED
					replace session_state REDACTED
					replace state REDACTED
					replace tag REDACTED
					replace tags REDACTED
					replace token REDACTED
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Forwarded delete
				request>headers>Proxy-Authorization delete
				request>headers>Referer delete
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				resp_headers>Location delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
