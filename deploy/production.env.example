# Copy to deploy/production.env (ignored by Git) and replace every example value.
# Keep PUBLIC_BIND_ADDRESS on loopback until the configured identity provider,
# public DNS, TLS, and operator-approved ingress policy have been tested together.
PUBLIC_HOST=research.example.com
ACME_EMAIL=operator@example.com
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

POSTGRES_DB=openscholar
POSTGRES_USER=openscholar
POSTGRES_PASSWORD_FILE=./secrets/postgres_password

# The production stack is fail-closed OIDC. This single-audience resource server
# expects the access-token audience to equal the canonical MCP resource URI.
OIDC_ISSUER_URI=https://identity.example.com
OIDC_JWK_SET_URI=https://identity.example.com/.well-known/jwks.json
OIDC_AUDIENCE=https://research.example.com/mcp
OIDC_MCP_RESOURCE_URI=https://research.example.com/mcp

# Register this as a confidential authorization-code client with PKCE. Keep both
# values in mode-0400 files; Compose mounts them without embedding them in image
# metadata or the rendered environment configuration. Generate the session key
# with: openssl rand -base64 32
AUTH_SESSION_SECRET_FILE=./secrets/auth_session_secret
OIDC_CLIENT_SECRET_FILE=./secrets/oidc_client_secret
OPENSCHOLAR_AUTH_SESSION_MAX_AGE_SECONDS=28800
OPENSCHOLAR_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/oauth2/authorize
OPENSCHOLAR_OIDC_TOKEN_ENDPOINT=https://identity.example.com/oauth2/token
OPENSCHOLAR_OIDC_END_SESSION_ENDPOINT=https://identity.example.com/logout
OPENSCHOLAR_OIDC_CLIENT_ID=openscholar-web
OPENSCHOLAR_OIDC_SCOPES=openid profile openscholar.search openscholar.library openscholar.jobs openscholar.privacy
OPENSCHOLAR_OIDC_ID_TOKEN_ALGS=RS256

# Replace both application placeholders with reviewed image:tag@sha256:<64-hex-digest> references.
BACKEND_IMAGE=ghcr.io/replace-me/openscholar-backend:reviewed
FRONTEND_IMAGE=ghcr.io/replace-me/openscholar-frontend:reviewed
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
PROMETHEUS_IMAGE=prom/prometheus:v3.5.5@sha256:332c2f43e7e389d74d3893b55bb02fbbd684208e681eeb604641d5d769c0fe2a
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.28.0@sha256:e753ff9f3fc458d02cca5eddab5a77e1c175eee484a8925ac7d524f04366c2fc
ALERTMANAGER_IMAGE=prom/alertmanager:v0.32.1@sha256:51a825c2a40acc3e338fdd00d622e01ec090f72be2b3ea46be0839cd47a4d286

# Create these host directories with the documented numeric ownership first.
CADDY_DATA_DIR=./state/caddy-data
PROMETHEUS_DATA_DIR=./state/prometheus
ALERTMANAGER_DATA_DIR=./state/alertmanager
PUBLIC_PROBE_TARGETS_FILE=./prometheus/targets/public-endpoints.json
PROMETHEUS_RETENTION=15d

# Starting budgets for a small portfolio deployment; load-test and tune them.
POSTGRES_CPUS=2.0
POSTGRES_MEMORY_LIMIT=4g
POSTGRES_PIDS_LIMIT=512
BACKEND_CPUS=2.0
BACKEND_MEMORY_LIMIT=2g
BACKEND_PIDS_LIMIT=512
FRONTEND_CPUS=1.0
FRONTEND_MEMORY_LIMIT=1g
FRONTEND_PIDS_LIMIT=256
PROXY_CPUS=1.0
PROXY_MEMORY_LIMIT=256m
PROXY_PIDS_LIMIT=128
PROMETHEUS_CPUS=1.0
PROMETHEUS_MEMORY_LIMIT=1g
PROMETHEUS_PIDS_LIMIT=256
BLACKBOX_EXPORTER_CPUS=0.5
BLACKBOX_EXPORTER_MEMORY_LIMIT=256m
BLACKBOX_EXPORTER_PIDS_LIMIT=128
ALERTMANAGER_CPUS=0.5
ALERTMANAGER_MEMORY_LIMIT=256m
ALERTMANAGER_PIDS_LIMIT=128

MCP_RATE_LIMIT_REQUESTS=120
MCP_RATE_LIMIT_WINDOW=1m
MCP_RATE_LIMIT_MAX_CLIENTS=10000
MCP_MAX_REQUEST_BYTES=1048576
MCP_MAX_TOOL_RESULT_BYTES=1048576
SEARCH_COORDINATION_WAIT_TIMEOUT=12s
SEARCH_EXECUTION_TIMEOUT=18s
RELATED_PAPERS_HYBRID_ENABLED=false

# Provider and durable-worker activation remains an explicit operational decision.
DATACITE_ENABLED=false
DATACITE_CONTACT_EMAIL=
DOAJ_ENABLED=false
DOAJ_CONTACT_EMAIL=
CORE_ENABLED=false
CORE_LICENSE_CONFIRMED=false
UNPAYWALL_EMAIL=
REFRESH_JOBS_WORKER_ENABLED=false
REFRESH_JOBS_SCHEDULED_ENABLED=false
REFRESH_JOBS_POLL_DELAY=5s
REFRESH_JOBS_SCAN_DELAY=1h
REFRESH_JOBS_LEASE_DURATION=2m
REFRESH_JOBS_RETRY_BACKOFF=30s
REFRESH_JOBS_MAX_ATTEMPTS=3
REFRESH_JOBS_PER_POLL=25
REFRESH_JOBS_STALE_TARGETS_PER_SCAN=100
