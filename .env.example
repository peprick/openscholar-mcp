POSTGRES_DB=openscholar
POSTGRES_USER=openscholar
POSTGRES_PASSWORD=openscholar
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000

# Provider credentials are passed only to the backend container.
OPENALEX_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_REQUEST_TIMEOUT=10s
OPENALEX_MAX_RESPONSE_BYTES=8388608
UNPAYWALL_EMAIL=
UNPAYWALL_BASE_URL=https://api.unpaywall.org
ARXIV_BASE_URL=https://export.arxiv.org/api

# Required before the /mcp endpoint accepts requests. Generate a long random value;
# keep it out of Git and pass it as: Authorization: Bearer <value>
MCP_LOCAL_API_KEY=

# Optional comma-separated exact origins for MCP clients or proxies that send Origin.
# This is a DNS-rebinding check, not a general CORS switch; clients that omit Origin are accepted.
MCP_ALLOWED_ORIGINS=http://127.0.0.1:6274,http://localhost:6274

# Authenticated MCP requests are limited per server-observed remote address.
MCP_RATE_LIMIT_ENABLED=true
MCP_RATE_LIMIT_REQUESTS=120
MCP_RATE_LIMIT_WINDOW=1m
MCP_RATE_LIMIT_MAX_CLIENTS=10000
