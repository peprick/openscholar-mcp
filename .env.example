POSTGRES_DB=openscholar
POSTGRES_USER=openscholar
POSTGRES_PASSWORD=openscholar
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000

# Hosted mode only. Local mode remains unauthenticated except for MCP_LOCAL_API_KEY.
# The issuer must mint OAuth access tokens with the configured audience and scopes.
OIDC_SECURITY_ENABLED=false
OIDC_ISSUER_URI=
OIDC_JWK_SET_URI=
OIDC_AUDIENCE=
OIDC_MCP_RESOURCE_URI=

# Frontend OIDC BFF. Leave local mode enabled for the default developer stack.
# Hosted values are server-only; never expose them through NEXT_PUBLIC_* names.
OPENSCHOLAR_AUTH_MODE=local
# Generate exactly 32 random bytes encoded as base64: openssl rand -base64 32
OPENSCHOLAR_AUTH_SESSION_SECRET=
OPENSCHOLAR_AUTH_SESSION_MAX_AGE_SECONDS=28800
# These should match OIDC_ISSUER_URI and OIDC_JWK_SET_URI; the local Compose
# file falls back to those backend values when these two fields are blank.
OPENSCHOLAR_OIDC_ISSUER=
OPENSCHOLAR_OIDC_AUTHORIZATION_ENDPOINT=
OPENSCHOLAR_OIDC_TOKEN_ENDPOINT=
OPENSCHOLAR_OIDC_JWKS_URI=
OPENSCHOLAR_OIDC_END_SESSION_ENDPOINT=
OPENSCHOLAR_OIDC_CLIENT_ID=
OPENSCHOLAR_OIDC_CLIENT_AUTH_METHOD=none
OPENSCHOLAR_OIDC_CLIENT_SECRET=
OPENSCHOLAR_OIDC_REDIRECT_URI=
OPENSCHOLAR_OIDC_POST_LOGOUT_REDIRECT_URI=
OPENSCHOLAR_OIDC_SCOPES=openid profile openscholar.search openscholar.library openscholar.privacy
OPENSCHOLAR_OIDC_ID_TOKEN_ALGS=RS256

# Provider credentials are passed only to the backend container.
OPENALEX_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_REQUEST_TIMEOUT=10s
OPENALEX_MAX_RESPONSE_BYTES=8388608
# DOAJ article discovery is keyless and disabled unless explicitly enabled.
DOAJ_ENABLED=false
DOAJ_BASE_URL=https://doaj.org/api/v4
DOAJ_CONTACT_EMAIL=
DOAJ_CONNECT_TIMEOUT=3s
DOAJ_REQUEST_TIMEOUT=10s
DOAJ_MAX_RESPONSE_BYTES=8388608
# CORE remains off until authorized API use/licence and the current terms are confirmed.
CORE_ENABLED=false
CORE_LICENSE_CONFIRMED=false
CORE_API_KEY=
CORE_BASE_URL=https://api.core.ac.uk
CORE_CONNECT_TIMEOUT=3s
CORE_REQUEST_TIMEOUT=10s
CORE_MAX_RESPONSE_BYTES=8388608
# DataCite thesis/dissertation metadata discovery is keyless and opt-in.
DATACITE_ENABLED=false
DATACITE_BASE_URL=https://api.datacite.org
DATACITE_CONTACT_EMAIL=
DATACITE_CONNECT_TIMEOUT=3s
DATACITE_REQUEST_TIMEOUT=10s
DATACITE_MAX_RESPONSE_BYTES=8388608
SEARCH_COORDINATION_WAIT_TIMEOUT=12s
SEARCH_EXECUTION_TIMEOUT=18s
RELATED_PAPERS_HYBRID_ENABLED=false
RELATED_PAPERS_HYBRID_CANDIDATE_POOL_SIZE=100
UNPAYWALL_EMAIL=
UNPAYWALL_BASE_URL=https://api.unpaywall.org
ARXIV_BASE_URL=https://export.arxiv.org/api

# Required before the /mcp endpoint accepts requests. Generate a long random value;
# keep it out of Git and pass it as: Authorization: Bearer <value>
MCP_LOCAL_API_KEY=

# Optional comma-separated exact origins for MCP clients or proxies that send Origin.
# This is a DNS-rebinding check, not a general CORS switch; clients that omit Origin are accepted.
MCP_ALLOWED_ORIGINS=http://127.0.0.1:6274,http://localhost:6274

# Hosted MCP requests are limited per issuer/subject; local-mode requests use
# the server-observed remote address.
MCP_RATE_LIMIT_ENABLED=true
MCP_RATE_LIMIT_REQUESTS=120
MCP_RATE_LIMIT_WINDOW=1m
MCP_RATE_LIMIT_MAX_CLIENTS=10000
MCP_MAX_REQUEST_BYTES=1048576
MCP_MAX_TOOL_RESULT_BYTES=1048576

# Durable stale metadata/access refreshes are disabled by default. Scheduled
# enqueuing requires the worker to be enabled as well.
REFRESH_JOBS_WORKER_ENABLED=false
REFRESH_JOBS_SCHEDULED_ENABLED=false
REFRESH_JOBS_POLL_DELAY=5s
REFRESH_JOBS_SCAN_DELAY=1h
REFRESH_JOBS_LEASE_DURATION=2m
REFRESH_JOBS_RETRY_BACKOFF=30s
REFRESH_JOBS_MAX_ATTEMPTS=3
REFRESH_JOBS_PER_POLL=25
REFRESH_JOBS_STALE_TARGETS_PER_SCAN=100
